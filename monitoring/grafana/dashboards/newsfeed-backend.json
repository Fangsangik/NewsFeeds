      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "pointSize": 3
          }
        }
      },
