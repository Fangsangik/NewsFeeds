      "targets": [
        {
          "refId": "A",
          "alias": "$tag_uri",
          "datasource": {
            "type": "influxdb",
            "uid": "nf-influx-springboot"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT non_negative_derivative(mean(\"count\"), 1s) FROM \"http_server_requests\" WHERE $timeFilter GROUP BY time($__interval), \"uri\" fill(none)"
