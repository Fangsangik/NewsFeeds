    {
      "id": 20,
      "type": "timeseries",
      "title": "HTTP Requests (TPS) by URI",
      "datasource": {
        "type": "influxdb",
        "uid": "nf-influx-springboot"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
