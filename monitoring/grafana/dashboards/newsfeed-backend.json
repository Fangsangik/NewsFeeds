{
  "uid": "newsfeed-backend",
  "title": "Newsfeed Backend (CPU/Thread/JVM/HTTP)",
  "tags": [
    "newsfeed",
    "spring-boot"
  ],
  "schemaVersion": 38,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Process CPU %",
      "datasource": {
        "type": "influxdb",
        "uid": "nf-influx-springboot"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "nf-influx-springboot"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"value\")*100 FROM \"process_cpu_usage\" WHERE $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
    {
